  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GestorDialogosCinematica
  reloj: {fileID: 0}
  dialogos:
  - nombre: Primer Dialogo
    texto: {fileID: 2087151973}
    contenido: Hace mucho tiempo un loquito se fumo uno
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 3
    duracionAparicion: 2
    tiempoVisible: 1.1
    duracionDesaparicion: 2
  - nombre: Segundo Dialogo
    texto: {fileID: 685704152}
    contenido: Ese porro estaba muy fuerte y emprendio un viaje
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 9
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: Tercer Dialogo
    texto: {fileID: 2084284464}
    contenido: Sin embargo, no era cualquier viaje
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 15
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: Cuarto Dialogo
    texto: {fileID: 2087151973}
    contenido: Era el viaje para encontrar el legendario MegaPorro
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 21
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: Quinto Dialogo
    texto: {fileID: 685704152}
    contenido: Que se encontraba en lo mas alto del pico
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 27
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: Sexto Dialogo
    texto: {fileID: 2084284464}
    contenido: Sin embargo, no seria una tarea facil
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 34
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: Septimo Dialogo
    texto: {fileID: 2087151973}
    contenido: Ya que tendria que pasar por lugares peligrosos entre los cuales estan
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 40
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: Octavo Dialogo
    texto: {fileID: 685704152}
    contenido: El bosque de Mamas Solteras
    posicion: {x: 0, y: -420, z: 0}
    tiempoInicio: 46
    duracionAparicion: 2
    tiempoVisible: 1
    duracionDesaparicion: 2
  - nombre: 
